# Скопируйте в .env.local и поправьте под себя. .env.local в .gitignore.
#
# Vite отдаёт в браузер только переменные с префиксом VITE_ — и отдаёт их
# всем, кто откроет сайт. Секретам здесь не место.

# Адрес API вместе с версией.
#   локально: http://localhost:8000/api/v1
#   в бою:    https://api.ritmritm.ru/api/v1
#
# Не задан — включается демо-режим (src/api/demo.ts): регистрация, вход,
# тарифы и «оплата» живут в localStorage браузера. Именно так собирается
# сборка для GitHub Pages, где бэкенда нет.
VITE_API_URL=http://localhost:8000/api/v1

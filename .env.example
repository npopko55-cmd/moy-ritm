# Скопируйте в .env.local и поправьте под себя. .env.local в .gitignore.
#
# Vite отдаёт в браузер только переменные с префиксом VITE_ — и отдаёт их
# всем, кто откроет сайт. Секретам здесь не место.

# Адрес API вместе с версией.
#   локально: http://localhost:8000/api/v1
#   в бою:    https://ritmritm.ru/api/v1
#
# Не задан — включается демо-режим (src/api/demo.ts): регистрация, вход,
# тарифы и «оплата» живут в localStorage браузера. Именно так собирается
# сборка для GitHub Pages, где бэкенда нет.
VITE_API_URL=http://localhost:8000/api/v1

# Счётчики рекламы (src/lib/analytics.ts): номер счётчика Яндекс Метрики и
# id пикселя VK Ads (Top.Mail.ru). Пусто — счётчик не грузится вовсе.
# Даже с id счётчики ждут согласия человека в баннере cookies — так обещает
# политика сайта (раздел 7). VITE_ANALYTICS_NO_CONSENT=1 грузит их без
# выбора: только после правки политики юристами.
# Проверить без отправки: npm run dev и адрес с ?analytics=dry.
VITE_YM_COUNTER_ID=
VITE_VK_PIXEL_ID=
VITE_ANALYTICS_NO_CONSENT=
